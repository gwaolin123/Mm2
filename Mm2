-- FEATURES:
-- 1. ESP: Murderer = RED, Sheriff = BLUE, Innocent = GREEN
-- 2. Aimbot for Sheriff (auto-locks on Murderer)
-- 3. Hitbox expand for Murderer (easier kills)
-- 4. Semi-invisible for Innocent
-- 5. Dragable GUI with Hide/Show (circle button)
-- 6. All buttons toggle ON/OFF

local espEnabled = true
local aimbotEnabled = false
local hitboxEnabled = false
local invisibleEnabled = false

